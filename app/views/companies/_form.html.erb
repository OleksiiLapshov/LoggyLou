<%= form_with(model: company, local: true) do |form| %>
  <% if company.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(company.errors.count, "error") %> prohibited this company from being saved:</h2>

      <ul>
        <% company.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :name, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :name, required: true, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :address_line_1, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :address_line_1, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :address_line_2, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :address_line_2, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :postcode, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :postcode, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :city, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :city, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :country, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :country, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :vat, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :vat, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :account_number, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :account_number, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :contact_phone, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :contact_phone, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :contact_email, class: "font-bold min-w-[120px]" %>
    <%= form.email_field :contact_email, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-4 py-2 items-center">
    <%= form.label :contact_person, class: "font-bold min-w-[120px]" %>
    <%= form.text_field :contact_person, class: "rounded-sm border border-zinc-900 bg-zinc-200" %>
  </div>

  <div class="flex gap-3 pt-6">
      <div>
        <%= back_button %>
      </div>
      <div class="button-success">
        <%= form.submit %>
      </div>
  </div>

<% end %>